{
  "name": "handeck",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "typescript": "^6.0.3",
      "next-themes": "^0.4.6",
      "lucide-react": "^1.16.0",
      "react": "^19.2.5",
      "react-dom": "^19.2.5",
      "@types/react": "^19.2.15",
      "@tanstack/react-query": "^5.100.11",
      "tailwindcss": "^4.2.2",
      "sonner": "^2.0.7",
      "@better-auth-ui/core": "^1.6.8",
      "@better-auth-ui/react": "^1.6.8",
      "convex": "^1.39.1",
      "better-auth": "1.6.11",
      "@convex-dev/better-auth": "^0.12.1",
      "@types/react-dom": "^19.2.3",
      "@types/bun": "^1.3.14"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "build:web": "turbo -F web build",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F @handeck/backend dev",
    "dev:setup": "turbo -F @handeck/backend dev:setup",
    "lint": "oxlint --report-unused-disable-directives",
    "typecheck": "turbo typecheck",
    "format": "oxfmt",
    "test": "turbo test",
    "check": "bun run lint && bun run format --check && bun run typecheck && bun run test"
  },
  "dependencies": {
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@handeck/config": "workspace:*",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.66.0",
    "turbo": "^2.9.14",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.14"
}
