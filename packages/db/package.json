{
  "name": "@handeck/db",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./schema": {
      "default": "./src/schema/index.ts"
    },
    "./schema/*": {
      "default": "./src/schema/*.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "dependencies": {
    "@handeck/env": "workspace:*",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "postgres": "^3.4.9",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@handeck/config": "workspace:*",
    "@types/node": "catalog:",
    "drizzle-kit": "^0.31.8",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
