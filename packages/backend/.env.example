# Set automatically by `npx convex dev` — do not set manually.
# CONVEX_DEPLOYMENT=dev:...

# Web app public origin (e.g. http://localhost:3001 in dev).
# Must match VITE_APP_ORIGIN in prod.  NOTE: this is the *app* URL, not the Convex .site URL.
SITE_URL=http://localhost:3001

# Convex HTTP endpoint — from Convex dashboard.
# NOTE: this is the Convex *.convex.site URL, not the app URL.
CONVEX_SITE_URL=https://YOUR_DEPLOYMENT.convex.site

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Local dev only: comma-separated origins to add to BetterAuth trustedOrigins.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
