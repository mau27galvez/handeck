DATABASE_URL=postgres://user:password@host:5432/handeck

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3001
CEDICT_IMPORT_TOKEN=

DODO_PAYMENTS_API_KEY=your_api_key_here
DODO_PAYMENTS_WEBHOOK_SECRET=your_webhook_secret_here
DODO_PAYMENTS_MINI_PRODUCT_ID=pdt_your_mini_pack_product_id
DODO_PAYMENTS_REGULAR_PRODUCT_ID=pdt_your_regular_pack_product_id
DODO_PAYMENTS_IMPERIAL_PRODUCT_ID=pdt_your_imperial_pack_product_id

OPENROUTER_API_KEY=

S3_BUCKET=handeck-decks-dev
# Scope objects per environment. Use separate buckets and/or prefixes for local, preview, and prod.
# Local: local or local/<your-name>
# Preview: preview/<branch-or-deployment-id>
# Production: prod
S3_KEY_PREFIX=local
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=placeholder-access-key-id
AWS_SECRET_ACCESS_KEY=placeholder-secret-access-key
# Optional S3-compatible storage (e.g. Cloudflare R2, MinIO). Omit for AWS S3.
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=true

GEMINI_API_KEY=placeholder-gemini-api-key

# Deck generation flow control (optional — recommended defaults for local development)
OPENROUTER_SENTENCE_BATCH_RPM=20
OPENROUTER_SENTENCE_BATCH_CONCURRENCY=5
GEMINI_AUDIO_RPM=3
GEMINI_AUDIO_CONCURRENCY=3
DECK_SENTENCE_BATCH_WINDOW_SIZE=100
DECK_SENTENCE_AUDIO_WINDOW_SIZE=500
DECK_WORD_AUDIO_WINDOW_SIZE=500

# Inngest (deck generation). Required for local dev with the Inngest dev server.
# INNGEST_DEV=1 enables dev mode (no cloud keys needed). Omit or set INNGEST_DEV=0 in production.
INNGEST_DEV=1
# Production only — from the Inngest dashboard for your app environment:
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=
# Optional — custom Inngest dev server URL (default: http://localhost:8288)
# INNGEST_BASE_URL=http://localhost:8288

# Optional overrides. If omitted, server code falls back to Vercel deployment URLs,
# then http://localhost:3001 for local development. CORS_ORIGIN accepts comma-separated origins.
# BETTER_AUTH_URL=http://localhost:3001
# CORS_ORIGIN=http://localhost:3001

# Optional public URL of the web app for SSR auth UI baseURL.
# If omitted, server code falls back to https://${VERCEL_URL} on Vercel,
# then http://localhost:3001 for local development.
# VITE_APP_ORIGIN=https://your-app.example.com
