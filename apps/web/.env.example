DATABASE_URL=postgres://user:password@host:5432/handeck

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3001
CEDICT_IMPORT_TOKEN=

# Optional overrides. If omitted, server code falls back to Vercel deployment URLs,
# then http://localhost:3001 for local development. CORS_ORIGIN accepts comma-separated origins.
# BETTER_AUTH_URL=http://localhost:3001
# CORS_ORIGIN=http://localhost:3001

# Optional public URL of the web app for SSR auth UI baseURL.
# If omitted, server code falls back to https://${VERCEL_URL} on Vercel,
# then http://localhost:3001 for local development.
# VITE_APP_ORIGIN=https://your-app.example.com
