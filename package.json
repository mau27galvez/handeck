{
  "name": "handeck",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "typescript": "^6.0.3",
      "next-themes": "^0.4.6",
      "lucide-react": "^1.17.0",
      "react": "^19.2.7",
      "react-dom": "^19.2.7",
      "@types/react": "^19.2.16",
      "@tanstack/react-query": "^5.100.14",
      "tailwindcss": "^4.2.2",
      "sonner": "^2.0.7",
      "@better-auth-ui/core": "^1.6.15",
      "@better-auth-ui/react": "^1.6.15",
      "@orpc/client": "^1.14.4",
      "@orpc/openapi": "^1.14.4",
      "@orpc/server": "^1.14.4",
      "@orpc/zod": "^1.14.4",
      "drizzle-orm": "^0.45.1",
      "uuid": "^14.0.0",
      "better-auth": "1.6.13",
      "@types/node": "^24.13.0",
      "@types/react-dom": "^19.2.3",
      "@types/bun": "^1.3.14"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "build:web": "turbo -F web build",
    "dev:web": "turbo -F web dev",
    "db:push": "turbo -F @handeck/db db:push",
    "db:studio": "turbo -F @handeck/db db:studio",
    "db:generate": "turbo -F @handeck/db db:generate",
    "db:migrate": "turbo -F @handeck/db db:migrate",
    "lint": "oxlint --report-unused-disable-directives",
    "typecheck": "turbo typecheck",
    "format": "oxfmt",
    "test": "turbo test",
    "check": "bun run lint && bun run format --check && bun run typecheck && bun run test"
  },
  "dependencies": {
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@handeck/config": "workspace:*",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.67.0",
    "turbo": "^2.9.16",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.14"
}
