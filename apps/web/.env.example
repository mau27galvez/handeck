DATABASE_URL=postgres://user:password@host:5432/handeck

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3001
CEDICT_IMPORT_TOKEN=

# Optional override. If omitted, server code falls back to https://${VERCEL_URL} on Vercel,
# then http://localhost:3001 for local development.
# BETTER_AUTH_URL=http://localhost:3001
# CORS_ORIGIN=http://localhost:3001

# Production only: the public URL of the web app for SSR auth UI baseURL.
# Not needed for local dev - defaults to http://localhost:3001.
# VITE_APP_ORIGIN=https://your-app.example.com
